{
  "name": "markaroo/markaroo",
  "type": "wordpress-plugin",
  "description": "Visual feedback, collaboration & task management for websites.",
  "keywords": [
    "wordpress",
    "feedback",
    "collaboration",
    "task-management"
  ],
  "homepage": "https://github.com/markaroo/markaroo",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Emon Ahmed",
      "email": "get.emonahmed@gmail.com"
    }
  ],
  "support": {
    "issues": "https://github.com/markaroo/markaroo/issues",
    "source": "https://github.com/markaroo/markaroo"
  },
  "require": {
    "php": ">=8.1",
    "wpbones/wpbones": "^2.0.0",
    "wpbones/wpkirk-helpers": "~2.0"
  },
  "autoload": {
    "psr-4": {
      "Markaroo\\": "plugin/"
    },
    "files": [
      "functions.php"
    ]
  },
  "scripts": {
    "post-autoload-dump": [
      "php -r \"copy('vendor/wpbones/wpbones/src/Console/bin/bones', 'bones');\"",
      "php bones rename --update"
    ]
  }
}
