{
  "name": "markaroo/markaroo",
  "type": "wordpress-plugin",
  "description": "Visual feedback, collaboration & task management for websites.",
  "keywords": [
    "wordpress",
    "feedback",
    "collaboration",
    "task-management"
  ],
  "homepage": "https://github.com/markaroo/markaroo",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Emon Ahmed",
      "email": "get.emonahmed@gmail.com"
    }
  ],
  "support": {
    "issues": "https://github.com/markaroo/markaroo/issues",
    "source": "https://github.com/markaroo/markaroo"
  },
  "require": {
    "php": ">=8.1",
    "wpbones/wpbones": "^2.0.0",
    "wpbones/wpkirk-helpers": "~2.0"
  },
  "autoload": {
    "psr-4": {
      "Markaroo\\": "plugin/"
    },
    "files": [
      "functions.php",
      "plugin/Support/helpers.php"
    ]
  },
  "scripts": {
    "post-autoload-dump": [
      "php -r \"copy('vendor/wpbones/wpbones/src/Console/bin/bones', 'bones');\"",
      "php bones rename --update"
    ]
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.3",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2"
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
